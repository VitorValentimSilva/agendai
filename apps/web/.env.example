# URL da API (Nest). Em produção, a URL do projeto da API na Vercel.
API_URL="http://localhost:3001"

# Mesmo valor do PROXY_SECRET da API (repassa o IP real do cliente para o rate limit)
PROXY_SECRET="troque-por-um-segredo-compartilhado"

# Multiempresa por subdomínio (mesmo valor do ROOT_DOMAIN da API). Sem ele, use o link /n/slug.
# NEXT_PUBLIC_ROOT_DOMAIN="agendai.com.br"

# Opcional: usado pelo `npm run gen:api` (padrão: http://localhost:3001/openapi.json)
# OPENAPI_URL="http://localhost:3001/openapi.json"

# Opcional: scripts de prints/E2E com Chrome (puppeteer-core)
# CHROME_PATH="/usr/bin/google-chrome"
# WEB_URL="http://localhost:3000"
