# URL da API (Nest). Em produção, a URL do projeto da API na Vercel.
API_URL="http://localhost:3001"

# Opcional: usado pelo `npm run gen:api` (padrão: http://localhost:3001/openapi.json)
# OPENAPI_URL="http://localhost:3001/openapi.json"

# Opcional: scripts de prints/E2E com Chrome (puppeteer-core)
# CHROME_PATH="/usr/bin/google-chrome"
# WEB_URL="http://localhost:3000"
