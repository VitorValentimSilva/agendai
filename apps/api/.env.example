# Conexão com o Postgres. Na Neon, use a URL "pooled" aqui...
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agendai?schema=public"
# ...e a URL direta (sem pooler) aqui — usada pelo `prisma migrate`.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/agendai?schema=public"

# Segredo para assinar o JWT da sessão (gere com: openssl rand -base64 32)
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Origem do site (Next.js) liberada no CORS e usada nos links do .ics
WEB_ORIGIN="http://localhost:3000"

# Protege POST/GET /internal/reset-demo (a Vercel envia no cron automaticamente)
CRON_SECRET="troque-por-outro-segredo"

# URL pública desta API (links do feed iCal, webhook do Mercado Pago e retorno do Google)
PUBLIC_API_URL="http://localhost:3001"

# Mesmo valor no projeto do site: autentica o IP real do cliente repassado pelo proxy (rate limit)
PROXY_SECRET="troque-por-um-segredo-compartilhado"

# Cifra tokens de terceiros (Mercado Pago, Google). 32 bytes: openssl rand -base64 32
# Obrigatória em produção; em dev é derivada do JWT_SECRET.
ENCRYPTION_KEY=""

# Multiempresa por subdomínio (ex.: agendai.com.br → navalha.agendai.com.br). Opcional.
# ROOT_DOMAIN="agendai.com.br"

# ---- WhatsApp Cloud API (Meta). Sem token, os lembretes ficam em modo simulado. ----
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_APP_SECRET=""          # valida a assinatura do webhook
# WHATSAPP_VERIFY_TOKEN=""        # você escolhe; usado na verificação do webhook na Meta
# WHATSAPP_REMINDER_TEMPLATE=""   # template aprovado com 6 parâmetros + botões CONFIRMAR/CANCELAR
# WHATSAPP_WAITLIST_TEMPLATE=""   # template aprovado com 5 parâmetros
# WHATSAPP_TEMPLATE_LANG="pt_BR"

# ---- Mercado Pago (Pix). Sem token, o Pix fica em modo simulado. ----
# ALLOW_SIMULATIONS="false"        # Pix simulado fora da demo (padrão: só fora de produção)
# MP_ACCESS_TOKEN=""              # token da plataforma (cada negócio pode cadastrar o próprio no painel)
# MP_WEBHOOK_SECRET=""            # chave secreta das notificações (valida x-signature)

# ---- Google Calendar (OAuth). Sem credenciais, só o feed iCal fica disponível. ----
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Opcional
PORT=3001
# BUSINESS_SLUG="navalha-de-ouro"   # negócio servido pelas rotas públicas
# THROTTLE_LIMIT=60                 # req/min por IP nas rotas públicas
# BOOKING_THROTTLE_LIMIT=10         # agendamentos/min por IP
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agendai_test?schema=public"
