generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  PROFESSIONAL
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
  /// Aguardando pagamento Pix (bloqueia o horário até expirar)
  PENDING_PAYMENT
}

enum AppointmentSource {
  ONLINE
  MANUAL
}

enum PaymentMode {
  NONE
  DEPOSIT
  FULL
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELED
  REFUNDED
}

enum MessageDirection {
  OUT
  IN
}

enum WaitlistStatus {
  ACTIVE
  NOTIFIED
  BOOKED
  CANCELED
}

model Business {
  id                      String      @id @default(cuid())
  name                    String
  slug                    String      @unique
  description             String?
  phone                   String
  whatsapp                String
  email                   String?
  instagram               String?
  addressLine             String
  city                    String
  state                   String
  timezone                String      @default("America/Sao_Paulo")
  /// Intervalo entre o início de dois horários consecutivos (minutos)
  slotIntervalMinutes     Int         @default(30)
  /// Antecedência mínima para agendar online (minutos)
  minAdvanceMinutes       Int         @default(60)
  /// Quantos dias à frente o cliente pode agendar
  maxAdvanceDays          Int         @default(30)
  /// Até quantas horas antes o cliente pode cancelar/remarcar pelo link
  cancellationPolicyHours Int         @default(2)
  /// Segmento escolhido no cadastro (barbearia, salao, clinica, estudio)
  segment                 String      @default("barbearia")
  /// Pix: nenhum, sinal (depositPercent) ou valor total
  paymentMode             PaymentMode @default(NONE)
  depositPercent          Int         @default(30)
  paymentExpiryMinutes    Int         @default(30)
  /// Access token do Mercado Pago do negócio, cifrado (AES-256-GCM)
  mercadoPagoTokenEnc     String?
  /// Lembretes automáticos por WhatsApp
  remindersEnabled        Boolean     @default(true)
  reminderHoursBefore     Int         @default(24)
  createdAt               DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime    @updatedAt @db.Timestamptz(3)

  users         User[]
  professionals Professional[]
  services      Service[]
  timeOffs      TimeOff[]
  customers     Customer[]
  appointments  Appointment[]
  messages      MessageLog[]
  waitlist      WaitlistEntry[]
}

model User {
  id             String   @id @default(cuid())
  businessId     String
  professionalId String?  @unique
  name           String
  email          String   @unique
  passwordHash   String
  role           Role
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
}

model Professional {
  id                    String   @id @default(cuid())
  businessId            String
  name                  String
  bio                   String?
  avatarUrl             String?
  active                Boolean  @default(true)
  sortOrder             Int      @default(0)
  /// Percentual de comissão sobre atendimentos concluídos
  commissionPercent     Int      @default(40)
  /// Token secreto do feed iCal (assinar no Google Agenda/Apple/Outlook)
  calendarFeedToken     String?  @unique
  /// Google Calendar (OAuth): refresh token cifrado e agenda de destino
  googleRefreshTokenEnc String?
  googleCalendarId      String?
  googleEmail           String?
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?
  services     ProfessionalService[]
  workingHours WorkingHours[]
  timeOffs     TimeOff[]
  appointments Appointment[]
  waitlist     WaitlistEntry[]

  @@index([businessId])
}

model Service {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionals ProfessionalService[]
  appointments  Appointment[]

  @@index([businessId])
}

model ProfessionalService {
  professionalId String
  serviceId      String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
}

/// Intervalo de trabalho em horário local do negócio. Vários por dia são permitidos (ex.: manhã e tarde).
model WorkingHours {
  id             String @id @default(cuid())
  professionalId String
  /// 0 = domingo ... 6 = sábado
  weekday        Int
  /// Minutos desde 00:00 (ex.: 540 = 09:00)
  startMinute    Int
  endMinute      Int

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday])
}

/// Bloqueio de agenda. Sem professionalId = vale para o negócio inteiro (ex.: feriado).
model TimeOff {
  id             String   @id @default(cuid())
  businessId     String
  professionalId String?
  startsAt       DateTime @db.Timestamptz(3)
  endsAt         DateTime @db.Timestamptz(3)
  reason         String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([businessId, startsAt])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  /// Somente dígitos, com DDI (ex.: 5519999990000)
  whatsapp   String
  email      String?
  notes      String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  waitlist     WaitlistEntry[]
  messages     MessageLog[]

  @@unique([businessId, whatsapp])
}

model Appointment {
  id             String            @id @default(cuid())
  businessId     String
  serviceId      String
  professionalId String
  customerId     String
  startsAt       DateTime          @db.Timestamptz(3)
  endsAt         DateTime          @db.Timestamptz(3)
  priceCents     Int
  status         AppointmentStatus @default(SCHEDULED)
  source         AppointmentSource @default(ONLINE)
  code           String            @unique
  manageToken    String            @unique
  notes          String?
  canceledAt     DateTime?         @db.Timestamptz(3)
  /// Lembrete por WhatsApp já enviado
  reminderSentAt DateTime?         @db.Timestamptz(3)
  /// Como foi confirmado: WHATSAPP, PAINEL, PIX
  confirmedVia   String?
  /// Evento correspondente no Google Calendar do profissional
  googleEventId  String?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payment      Payment?
  messages     MessageLog[]

  @@index([businessId, startsAt])
  @@index([professionalId, startsAt])
  @@index([customerId])
  @@index([status, reminderSentAt, startsAt])
}

/// Cobrança Pix de um agendamento (sinal ou valor total)
model Payment {
  id                String        @id @default(cuid())
  appointmentId     String        @unique
  /// MERCADO_PAGO ou SIMULATED
  provider          String
  providerPaymentId String?       @unique
  amountCents       Int
  status            PaymentStatus @default(PENDING)
  qrCode            String?
  qrCodeBase64      String?
  ticketUrl         String?
  expiresAt         DateTime      @db.Timestamptz(3)
  paidAt            DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
}

/// Histórico de mensagens de WhatsApp (enviadas e recebidas)
model MessageLog {
  id                String           @id @default(cuid())
  businessId        String
  appointmentId     String?
  customerId        String?
  direction         MessageDirection
  /// reminder, waitlist, reply, inbound
  kind              String
  phone             String
  body              String
  /// WHATSAPP_CLOUD ou SIMULATED
  provider          String
  providerMessageId String?
  status            String           @default("sent")
  error             String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([phone, createdAt])
}

/// Fila de espera: cliente quer um horário num dia sem vagas
model WaitlistEntry {
  id             String         @id @default(cuid())
  businessId     String
  serviceId      String
  /// null = qualquer profissional
  professionalId String?
  customerId     String
  /// Data desejada (AAAA-MM-DD no fuso do negócio)
  date           String
  status         WaitlistStatus @default(ACTIVE)
  token          String         @unique
  notifiedAt     DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, serviceId, date])
  @@index([businessId, date, status])
}
