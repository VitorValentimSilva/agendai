generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  PROFESSIONAL
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  MANUAL
}

model Business {
  id                      String   @id @default(cuid())
  name                    String
  slug                    String   @unique
  description             String?
  phone                   String
  whatsapp                String
  email                   String?
  instagram               String?
  addressLine             String
  city                    String
  state                   String
  timezone                String   @default("America/Sao_Paulo")
  /// Intervalo entre o início de dois horários consecutivos (minutos)
  slotIntervalMinutes     Int      @default(30)
  /// Antecedência mínima para agendar online (minutos)
  minAdvanceMinutes       Int      @default(60)
  /// Quantos dias à frente o cliente pode agendar
  maxAdvanceDays          Int      @default(30)
  /// Até quantas horas antes o cliente pode cancelar/remarcar pelo link
  cancellationPolicyHours Int      @default(2)
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  users         User[]
  professionals Professional[]
  services      Service[]
  timeOffs      TimeOff[]
  customers     Customer[]
  appointments  Appointment[]
}

model User {
  id             String   @id @default(cuid())
  businessId     String
  professionalId String?  @unique
  name           String
  email          String   @unique
  passwordHash   String
  role           Role
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
}

model Professional {
  id         String   @id @default(cuid())
  businessId String
  name       String
  bio        String?
  avatarUrl  String?
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?
  services     ProfessionalService[]
  workingHours WorkingHours[]
  timeOffs     TimeOff[]
  appointments Appointment[]

  @@index([businessId])
}

model Service {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionals ProfessionalService[]
  appointments  Appointment[]

  @@index([businessId])
}

model ProfessionalService {
  professionalId String
  serviceId      String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
}

/// Intervalo de trabalho em horário local do negócio. Vários por dia são permitidos (ex.: manhã e tarde).
model WorkingHours {
  id             String @id @default(cuid())
  professionalId String
  /// 0 = domingo ... 6 = sábado
  weekday        Int
  /// Minutos desde 00:00 (ex.: 540 = 09:00)
  startMinute    Int
  endMinute      Int

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday])
}

/// Bloqueio de agenda. Sem professionalId = vale para o negócio inteiro (ex.: feriado).
model TimeOff {
  id             String   @id @default(cuid())
  businessId     String
  professionalId String?
  startsAt       DateTime @db.Timestamptz(3)
  endsAt         DateTime @db.Timestamptz(3)
  reason         String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([businessId, startsAt])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  /// Somente dígitos, com DDI (ex.: 5519999990000)
  whatsapp   String
  email      String?
  notes      String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([businessId, whatsapp])
}

model Appointment {
  id             String            @id @default(cuid())
  businessId     String
  serviceId      String
  professionalId String
  customerId     String
  startsAt       DateTime          @db.Timestamptz(3)
  endsAt         DateTime          @db.Timestamptz(3)
  priceCents     Int
  status         AppointmentStatus @default(SCHEDULED)
  source         AppointmentSource @default(ONLINE)
  code           String            @unique
  manageToken    String            @unique
  notes          String?
  canceledAt     DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([businessId, startsAt])
  @@index([professionalId, startsAt])
  @@index([customerId])
}
